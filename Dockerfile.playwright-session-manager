# Playwright session manager for the console UI (published as
# temeteke/pyscraper-playwright-session-manager + GHCR).
# Only the playwright *client* package is needed (remote connect to the
# nodes); no browser binaries are installed in this image.
# Keep PLAYWRIGHT_VERSION in sync with setup.cfg,
# Dockerfile.playwright-node, and Dockerfile.standalone. Keep
# FASTAPI_VERSION / UVICORN_VERSION in sync with setup.cfg (console
# extra) and Dockerfile.selenium-session-manager (no pin test exists).
ARG PLAYWRIGHT_VERSION=1.62.0
ARG FASTAPI_VERSION=0.119.0
ARG UVICORN_VERSION=0.37.0
FROM python:3.12-slim

ARG PLAYWRIGHT_VERSION
ARG FASTAPI_VERSION
ARG UVICORN_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "playwright==${PLAYWRIGHT_VERSION}" \
    "fastapi==${FASTAPI_VERSION}" "uvicorn==${UVICORN_VERSION}"

COPY servers/playwright_session_manager.py /app/session_manager.py

EXPOSE 8081

CMD ["python", "/app/session_manager.py"]
