# Selenium session manager for the gateway UI (local build only, not published).
# FastAPI + uvicorn (Grid access itself is plain urllib).
# Keep FASTAPI_VERSION / UVICORN_VERSION in sync with setup.cfg
# (gateway extra) and Dockerfile.playwright-session-manager
# (no pin test exists).
ARG FASTAPI_VERSION=0.119.0
ARG UVICORN_VERSION=0.37.0
FROM python:3.12-slim

ARG FASTAPI_VERSION
ARG UVICORN_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "fastapi==${FASTAPI_VERSION}" "uvicorn==${UVICORN_VERSION}"

COPY servers/selenium_session_manager.py /app/session_manager.py

EXPOSE 8082

CMD ["python", "/app/session_manager.py"]
