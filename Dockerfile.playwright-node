# Playwright node (all browsers, single Dockerfile + build-arg).
# Keep PLAYWRIGHT_VERSION in sync with setup.cfg and
# Dockerfile.playwright-session-manager (single source of truth
# is the client dependency; the node must speak the same protocol version).
ARG PLAYWRIGHT_BROWSER=chromium
FROM python:3.12-slim

ARG PLAYWRIGHT_BROWSER
ARG PLAYWRIGHT_VERSION=1.62.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "playwright==${PLAYWRIGHT_VERSION}" && \
    playwright install --with-deps ${PLAYWRIGHT_BROWSER}

# The node needs only playwright: servers/playwright_node.py is
# self-contained (stdlib + playwright) and must not import pyscraper.
COPY servers/playwright_node.py /app/playwright_node.py
COPY servers/playwright-entrypoint-node.sh /app/entrypoint-node.sh
RUN chmod +x /app/entrypoint-node.sh

EXPOSE 3000 5900 7900

CMD ["/app/entrypoint-node.sh"]
